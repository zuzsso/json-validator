{
  "name": "zuzsso/json-validator",
  "description": "Common shareable functionality",
  "type": "library",
  "authors": [
    {
      "name": "Nico Santamaria",
      "email": "ndsans@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "JsonValidator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JsonValidator\\Tests\\": "tests/"
    }
  },
  "require": {
    "ext-intl": "*",
    "php-di/php-di": "^7.0",
    "ext-json": "*",
    "zuzsso/di-manifest": "^2.0",
    "zuzsso/math": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "friendsofphp/php-cs-fixer": "*",
    "phpmd/phpmd": "@stable"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/zuzsso/di-manifest"
    },
    {
      "type": "vcs",
      "url": "https://github.com/zuzsso/math"
    }
  ]
}
